<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>x64</Platforms>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DebugType>embedded</DebugType>
        <Deterministic>true</Deterministic>
        <LangVersion>preview</LangVersion>
        <AssemblyName>Hypergryph.Yostar</AssemblyName>
        <ProductName>Hypergryph Yostar Protocol Library</ProductName>
        <Product>Collapse</Product>
        <Description>This library implements the Yostar launcher protocol used by Hypergryph games.</Description>
        <AssemblyTitle>Hypergryph Yostar Protocol Library</AssemblyTitle>
        <Company>Misaka10843</Company>
        <Authors>$(Company).</Authors>
        <Copyright>Copyright 2026 $(Company)</Copyright>
        <Version>1.0.0</Version>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hi3Helper.Plugin.Core\Hi3Helper.Plugin.Core.csproj"/>
    </ItemGroup>

</Project>
